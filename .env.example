# Connection for the REST test suites in tests/ (curl-*.sh, zowe-*.sh), which
# source this file. mbt 3 does not read it: deploy and `mbt test --mvs` use a
# target from ~/.mbt/targets.toml (`mbt target import .env --name <name>`
# turns this file into one).
MBT_MVS_HOST=mvs
MBT_MVS_PORT=1080
MBT_MVS_USER=IBMUSER
MBT_MVS_PASS=sys1

# Optional: an ordinary (non-admin) userid.
# The dataset suite's authorization tests need one -- an admin is permitted for
# almost every attribute, so a READ or UPDATE refusal is unreachable with it and
# those paths go untested. Leave unset to skip that section.
MVSMF_USER2=
MVSMF_PASS2=
